<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="img/logo-uv.svg" type="image/x-icon">
  <title>Iniciar Sesion</title>
  <link rel="stylesheet" href="css/login.css" />
</head>

<body>
  <% if (typeof error !=='undefined' ) { %>
    <div class="alert">
      <%= error %>
    </div>
    <% } %>
      <div class="container">
        <div class="auth-container">
          <form class="login-form" id="registerForm">
            <div style="width: 100%; display:flex; align-items:center; justify-content: center; margin-bottom: 20px;">
              <img src="img/logo-uv.svg" alt="logo-uv" style="width:100px;height:100px;object-fit:contain;">
            </div>
            <h2>Registrate</h2>
            <div class="input-group">
              <input type="text" id="name" name="nombres" required />
              <label for="name">Nombre</label>
            </div>
            <div class="input-group">
              <input type="text" id="paternal-surname" name="apellidoPaterno" required />
              <label for="paternal-surname">Apellido Paterno</label>
            </div>
            <div class="input-group">
              <input type="text" id="maternal-surname" name="apellidoMaterno" required />
              <label for="maternal-surname">Apellido Materno</label>
            </div>
            <div class="input-group">
              <input type="email" id="correo" name="correo" required />
              <label for="correo">Correo</label>
            </div>
            <div class="input-group">
              <input type="password" id="password" name="contraseña" required />
              <label for="password">Contraseña</label>
            </div>
            <button type="submit">Entrar</button>
            <div class="register-link">
              ¿Ya tienes cuenta? <a href="/login">Inicia Sesión</a>
            </div>
          </form>
          <div class="image-login">
            <picture>
              <img src="img/VectorBlue.png" alt="Vector azul">
            </picture>
          </div>
        </div>
      </div>

      <script src="/js/utils/toast.js"></script>
      <script src="js/auth.js"></script>
</body>

</html>