<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="/img/logo-uv.svg" type="image/x-icon">
  <title>Actualizar Contraseña - UV Archiver</title>
  <link rel="stylesheet" href="/css/login.css" />
</head>

<body>
  <% if (typeof error !== 'undefined') { %>
    <div class="alert">
      <%= error %>
    </div>
  <% } %>

  <div class="container">
    <div class="auth-container">
      <div class="image-login">
        <picture>
          <img src="/img/VectorBlue.png" alt="Vector azul">
        </picture>
      </div>

      <form class="login-form" id="updatePasswordForm">
        <div style="width: 100%; display:flex; align-items:center; justify-content: center; margin-bottom: 20px;">
          <img src="/img/logo-uv.svg" alt="logo-uv" style="width:100px;height:100px;object-fit:contain;">
        </div>
        <div class="logo" onclick="location.href='/'" style="scale:1.3; align-self: center; font-weight: bold; cursor: pointer;">
          <span style="color:var(--primary-color-accent);">U</span>
          <span style="color:var(--secondary-color);">V</span>
          Archiver
        </div>
        <h2 style="margin-top: 15px;">Actualizar Contraseña</h2>

        <div class="input-group">
          <input type="password" id="currentPassword" name="currentPassword" required />
          <label for="currentPassword">Contraseña Actual</label>
          <button type="button" class="toggle-password" onclick="togglePasswordVisibility('currentPassword', this)" title="Mostrar/ocultar contraseña">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
              <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
            </svg>
          </button>
        </div>

        <div class="input-group">
          <input type="password" id="newPassword" name="newPassword" required />
          <label for="newPassword">Nueva Contraseña</label>
          <button type="button" class="toggle-password" onclick="togglePasswordVisibility('newPassword', this)" title="Mostrar/ocultar contraseña">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
              <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
            </svg>
          </button>
        </div>

        <div class="input-group">
          <input type="password" id="newPasswordConfirm" name="newPasswordConfirm" required />
          <label for="newPasswordConfirm">Confirmar Nueva Contraseña</label>
          <button type="button" class="toggle-password" onclick="togglePasswordVisibility('newPasswordConfirm', this)" title="Mostrar/ocultar contraseña">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
              <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
            </svg>
          </button>
        </div>

        <div id="message" class="error-message" style="display: none;"></div>
        <button class="btn" type="submit" style="margin-top: 10px;">Guardar Nueva Contraseña</button>
        
        <div class="register-link" style="margin-top: 10px;">
          <a href="/profile">Volver al Perfil</a>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/utils/toast.js"></script>
  <script src="/js/auth.js"></script>
</body>

</html>