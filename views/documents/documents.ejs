<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/img/logo-uv.svg" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/index.css">

  <!-- Full Calendar-->
  <!-- STANDARD JS -->
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.0.2/all/global.js"></script>

  <!-- THEME JS -->
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@7.0.2/themes/monarch/global.js"></script>

  <!-- STYLESHEETS -->
  <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.2/skeleton.css' rel='stylesheet' />
  <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.2/themes/monarch/theme.css' rel='stylesheet' />
  <link href='https://cdn.jsdelivr.net/npm/fullcalendar@7.0.2/themes/monarch/palettes/purple.css' rel='stylesheet' />

  <title>Expedientes - UV Archiver</title>
</head>

<body>
  <%- include('../components/sidebar.ejs') %>
    <div class="container-user" id="container-user">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 15px;">
        <div style="display: flex; flex-direction: column;">
          <h1>
            Area de <%= nombreDepartamento %>
          </h1>
          <p>Expedientes y <strong>Documentos Administrativos</strong></p>
        </div>
        <div style="display: flex; flex-direction: row; align-items: center; gap: 5px;">
          <% if (viewScope==='own' && user && user.rol !==4 && user.id_departamento !==1 ) { %>
            <button class="title-btn open-modal-button" data-target="modal-container-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-file-plus">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2" />
                <path d="M12 11l0 6" />
                <path d="M9 14l6 0" />
              </svg>
              &nbsp;
              <p>Registrar Documento</p>
            </button>
            <% } %>
        </div>
      </div>

      <div class="search-container">
        <div class="input-search-group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-search">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
            <path d="M21 21l-6 -6" />
          </svg>
          <input type="search" id="searchInput" value="<%= (typeof pagination !== 'undefined' && pagination.search) ? pagination.search : '' %>" placeholder="Buscar por nombre de archivo o propietario">
          <div class="date-search">
            <label for="filter-date" class="date-picker">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
                class="icon icon-tabler icons-tabler-filled icon-tabler-calendar-event">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path
                  d="M16 2a1 1 0 0 1 .993 .883l.007 .117v1h1a3 3 0 0 1 2.995 2.824l.005 .176v12a3 3 0 0 1 -2.824 2.995l-.176 .005h-12a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-12a3 3 0 0 1 2.824 -2.995l.176 -.005h1v-1a1 1 0 0 1 1.993 -.117l.007 .117v1h6v-1a1 1 0 0 1 1 -1m3 8h-14v8.625c0 .705 .386 1.286 .883 1.366l.117 .009h12c.513 0 .936 -.53 .993 -1.215l.007 -.16zm-9 4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1z" />
              </svg>
            </label>
            <input type="date" id="filter-date" value="<%= (typeof pagination !== 'undefined' && pagination.date) ? pagination.date : '' %>">
          </div>
        </div>
      </div>
      <%- include('docsTable-view.ejs') %>
    </div>

    <!-- Modal Registrar Documento -->
    <% if (viewScope==='own' ) { %>
      <div id="modal-container-1" class="modal modal-content-1">
        <div id="modal-content">
          <div class="modal-head">
            <div class="modal-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-file-plus">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2" />
                <path d="M12 11l0 6" />
                <path d="M9 14l6 0" />
              </svg>
              &nbsp;
              <h3>Registrar Nuevo Documento</h3>
            </div>
            <button class="outline-btn close-modal-button" onclick="closeModal()">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-x">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M18 6l-12 12" />
                <path d="M6 6l12 12" />
              </svg>
            </button>
          </div>
          <%- include('formDcuments.ejs') %>
        </div>
      </div>

      <!-- Modal Editar Documento -->
      <div id="modal-container-edit-doc" class="modal modal-content-1">
        <div id="modal-content">
          <div class="modal-head">
            <div class="modal-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-edit">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
                <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
                <path d="M16 5l3 3" />
              </svg>
              &nbsp;
              <h3>Editar Documento</h3>
            </div>
            <button class="outline-btn close-modal-button" onclick="closeModal()">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-x">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M18 6l-12 12" />
                <path d="M6 6l12 12" />
              </svg>
            </button>
          </div>
          <form class="form-documento" id="form-edit-documento">
            <input type="hidden" id="edit-doc-id" name="id">
            <div class="form-grid">
              <div class="form-field full">
                <label for="edit-doc-nombre">Nombre del documento</label>
                <input type="text" id="edit-doc-nombre" name="nombre" maxlength="100" placeholder="Ej. Contrato de servicios 2026" required>
              </div>

              <div class="form-field full">
                <label for="edit-doc-privado" style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 0.95rem;">
                  <input type="checkbox" name="privado" id="edit-doc-privado" style="width: 18px; height: 18px; cursor: pointer;">
                  ¿Este documento es privado o confidencial?
                </label>
              </div>

              <div class="submit-container">
                <button type="submit" class="title-btn">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-device-floppy">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M6 4h10l4 4v10a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2" />
                    <path d="M10 14a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M14 4l0 4l-6 0l0 -4" />
                  </svg>
                  &nbsp;Guardar Cambios
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
      <% } %>

        <!-- Modal PDF -->
        <div id="modal-container-2" class="modal modal-content-2">
          <div id="modal-content"
            style="max-width: 80%; width: 900px; height: 600px; display: flex; flex-direction: column;">
            <div class="modal-head" style="flex-shrink: 0;">
              <div class="modal-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-file-3d">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                  <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2" />
                  <path d="M12 13.5l4 -1.5" />
                  <path d="M8 11.846l4 1.654v4.5l4 -1.846v-4.308l-4 -1.846l-4 1.846" />
                  <path d="M8 12v4.2l4 1.8" />
                </svg>
                &nbsp;
                <h3>Ver Documento</h3>
              </div>
              <button class="outline-btn close-modal-button" onclick="closeModal(), cerrarPDF()">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="icon icon-tabler icons-tabler-outline icon-tabler-x">
                  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                  <path d="M18 6l-12 12" />
                  <path d="M6 6l12 12" />
                </svg>
              </button>
            </div>
            <%- include('../components/pdfModal.ejs') %>
          </div>
        </div>
        <script src="/js/components/documentos.components.js"></script>
        <script src="/js/components/sidebar.js"></script>
        <script src="/js/components/modals.js"></script>
</body>

</html>