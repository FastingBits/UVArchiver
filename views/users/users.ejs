<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="img/logo-uv.svg" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="css/index.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <title>Usuarios - UV Archiver</title>
</head>

<body>
  <%- include('../components/sidebar.ejs') %>
    <div class="container-user" id="container-user">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
        <div style="display: flex; flex-direction: column;">
          <h1>Usuarios</h1>
          <p>Administracion de <strong>Usuarios</strong> del sistema</p>
        </div>
        <% if (user && (user.rol===1 || user.rol===2)) { %>
          <button class="title-btn open-modal-button" data-target="modal-container-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-user-plus">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
              <path d="M16 19h6" />
              <path d="M19 16v6" />
              <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
            </svg>
            &nbsp;
            <p>Registrar Usuario</p>
          </button>
          <% } %>
      </div>
      <div class="search-container">
        <div class="input-search-group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-search">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
            <path d="M21 21l-6 -6" />
          </svg>
          <input type="search" id="search-input" value="<%= (typeof pagination !== 'undefined' && pagination.search) ? pagination.search : '' %>" placeholder="Buscar por nombre de usuario, correo o rol">
        </div>
      </div>
      <div class="table-container">
        <table class="doc-table">
          <thead>
            <tr>
              <th>NOMBRE DE USUARIO</th>
              <th>CORREO</th>
              <th>ROL</th>
              <th>DE LA INSTITUCIÓN</th>
              <th>DEPARTAMENTO</th>
              <th>FECHA REGISTRO</th>
              <th>ACCIONES</th>
            </tr>
          </thead>
          <tbody>
            <% usuarios.forEach(function(usr) { %>
              <tr data-date="<%= new Date(usr.fecha_registro).toISOString().split('T')[0] %>">
                <td class="file-cell">
                  <div class="file-icon" data-type="<%= usr.nombre %>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="icon icon-tabler icons-tabler-outline icon-tabler-user">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                      <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                    </svg>
                  </div>
                  <div class="file-info">
                    <div class="file-name">
                      <%= usr.nombre %>
                        <%= usr.apellido_paterno %>
                          <%= usr.apellido_materno %>
                    </div>
                  </div>
                </td>
                <td class="category-cell">
                  <%= usr.correo %>
                </td>
                <td class="date-cell">
                  <span class="badge-role-<%= usr.nombre_rol %>">
                    <%= usr.nombre_rol %>
                  </span>
                </td>
                <td class="owner-cell">
                  <span class="<%= usr.pertenece_a_institucion === 1 ? 'badge-inst-yes' : 'badge-inst-no' %>">
                    <%= usr.pertenece_a_institucion===1 ? 'Institucional' : 'Externo' %>
                  </span>
                </td>
                <td class="owner-cell">
                  <%= usr.nombre_departamento %>
                </td>
                <td class="owner-cell">
                  <%= new Date(usr.fecha_registro).toLocaleDateString('es-ES', { year: 'numeric' , month: 'long' ,
                    day: '2-digit' }) %>
                </td>
                <td class="actions-cell">
                  <button title="Editar Usuario" class="action-btn edit-btn open-modal-button"
                    data-target="modal-container-2"
                    onclick="openEditUserModal('<%= usr.id_usuario %>', '<%= usr.nombre %>', '<%= usr.apellido_paterno %>', '<%= usr.apellido_materno %>', '<%= usr.correo %>', '<%= usr.id_departamento %>', '<%= usr.id_rol %>', '<%= usr.pertenece_a_institucion %>')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="icon icon-tabler icons-tabler-outline icon-tabler-pencil">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                      <path d="M13.5 6.5l4 4" />
                    </svg>
                  </button>
                  <% if (user && user.rol===1) { %>
                    <button title="Eliminar Usuario" class="action-btn delete-btn"
                      onclick="deleteUser('<%= usr.id_usuario %>')">
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                        fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-trash">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path
                          d="M20 6a1 1 0 0 1 .117 1.993l-.117 .007h-.081l-.919 11a3 3 0 0 1 -2.824 2.995l-.176 .005h-8c-1.598 0 -2.904 -1.249 -2.992 -2.75l-.005 -.167l-.923 -11.083h-.08a1 1 0 0 1 -.117 -1.993l.117 -.007zm-10 4a1 1 0 0 0 -1 1v6a1 1 0 0 0 2 0v-6a1 1 0 0 0 -1 -1m4 0a1 1 0 0 0 -1 1v6a1 1 0 0 0 2 0v-6a1 1 0 0 0 -1 -1" />
                        <path
                          d="M14 2a2 2 0 0 1 2 2a1 1 0 0 1 -1.993 .117l-.007 -.117h-4l-.007 .117a1 1 0 0 1 -1.993 -.117a2 2 0 0 1 1.85 -1.995l.15 -.005z" />
                      </svg>
                    </button>
                    <% } %>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
        <%- include('../components/pagination.ejs', { pagination: pagination, baseUrl: '/usuarios' }) %>
      </div>
    </div>
    <div id="modal-container-1" class="modal modal-content-1">
      <div id="modal-content">
        <div class="modal-head">
          <div class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-user-plus">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
              <path d="M16 19h6" />
              <path d="M19 16v6" />
              <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
            </svg>
            &nbsp;
            <h3>Registrar Nuevo Usuario</h3>
          </div>
          <button class="outline-btn close-modal-button" onclick="closeModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-x">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M18 6l-12 12" />
              <path d="M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form class="form-documento" id="register-form" method="post" autocomplete="off">
          <div class="form-grid" style="border:none; background-color: transparent;">
            <div class="form-field">
              <label for="nombre">Nombre(s)</label>
              <input type="text" id="nombre" name="nombre" maxlength="100" placeholder="Nombre(s)" autocomplete="off"
                required>
            </div>
            <div class="form-field">
              <label for="paternal-surname">Apellido Paterno</label>
              <input type="text" id="paternal-surname" name="apellidoPaterno" placeholder="Apellido Paterno"
                autocomplete="off" required />
            </div>
            <div class="form-field">
              <label for="maternal-surname">Apellido Materno</label>
              <input type="text" id="maternal-surname" name="apellidoMaterno" placeholder="Apellido Materno"
                autocomplete="off" required />
            </div>
            <div class="form-field">
              <label for="perteneceAInstitucion">¿Pertenece a la institución?</label>
              <select name="perteneceAInstitucion" id="perteneceAInstitucion" required>
                <option value="1">Sí</option>
                <option value="0">No</option>
              </select>
            </div>
            <% if (user.rol===1) { %>
              <div class="form-field">
                <label for="departamento">Departamento</label>
                <select name="departamento" id="departamento" required>
                  <% departamentos.forEach(function(dep) { %>
                    <option value="<%= dep.id_departamento %>">
                      <%= dep.nombre %>
                    </option>
                    <% }); %>
                </select>
              </div>
              <div class="form-field">
                <label for="rol">Rol</label>
                <select name="rol" id="rol" required>
                  <% roles.forEach(function(role) { %>
                    <% if(user.rol===1){ %>
                      <option value="<%= role.id_rol %>">
                        <%= role.nombre %>
                      </option>
                      <% }else if(user.rol>=2 && role.id_rol>1){ %>
                        <option value="<%= role.id_rol %>">
                          <%= role.nombre %>
                        </option>
                        <% } }); %>
                </select>
              </div>
              <% } else { %>
                <div class="form-field full">
                  <label for="rol">Rol</label>
                  <select name="rol" id="rol" required>
                    <% roles.forEach(function(role) { %>
                      <% if(user.rol>=2 && role.id_rol>1){ %>
                        <option value="<%= role.id_rol %>">
                          <%= role.nombre %>
                        </option>
                        <% } }); %>
                  </select>
                </div>
                <% } %>
                  <div class="form-field full">
                    <label for="correo">Correo Electrónico</label>
                    <input type="email" id="correo" name="correo" placeholder="email@uv.mx" autocomplete="off"
                      required />
                  </div>
                  <div class="form-field full">
                    <label for="password">Contraseña</label>
                    <div class="password-input-wrapper">
                      <input type="password" id="password" name="contraseña" placeholder="Contraseña"
                        autocomplete="new-password" required />
                      <button type="button" class="toggle-password" id="toggleAll" onclick="toggleAllPasswords()"
                        title="Mostrar u ocultar contraseña">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                          class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
                          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                          <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                          <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                        </svg>
                      </button>
                    </div>
                  </div>
                  <div class="form-field full" style="margin-top: 6px;">
                    <button class="title-btn" style="width: 100%; justify-content: center; padding: 12px;"
                      type="submit">Registrar Usuario</button>
                  </div>
          </div>
        </form>
      </div>
    </div>
    <!-- Modal para Editar Usuario -->
    <div id="modal-container-2" class="modal modal-content-2">
      <div id="modal-content">
        <div class="modal-head">
          <div class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-pencil">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
              <path d="M13.5 6.5l4 4" />
            </svg>
            &nbsp;
            <h3>Editar Usuario</h3>
          </div>
          <button class="outline-btn close-modal-button" onclick="closeModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-x">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M18 6l-12 12" />
              <path d="M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form class="form-documento" id="edit-user-form" method="post" autocomplete="off">
          <input type="hidden" id="edit-id" name="id">
          <div class="form-grid" style="border:none; background-color: transparent;">
            <div class="form-field">
              <label for="edit-nombre">Nombre(s)</label>
              <input type="text" id="edit-nombre" name="nombre" placeholder="Nombre(s)" autocomplete="off" required>
            </div>
            <div class="form-field">
              <label for="edit-paternal">Apellido Paterno</label>
              <input type="text" id="edit-paternal" name="apellidoPaterno" placeholder="Apellido Paterno"
                autocomplete="off" required />
            </div>
            <div class="form-field">
              <label for="edit-maternal">Apellido Materno</label>
              <input type="text" id="edit-maternal" name="apellidoMaterno" placeholder="Apellido Materno"
                autocomplete="off" required />
            </div>
            <div class="form-field">
              <label for="edit-perteneceAInstitucion">¿Pertenece a la institución?</label>
              <select name="perteneceAInstitucion" id="edit-perteneceAInstitucion" required>
                <option value="1">Sí</option>
                <option value="0">No</option>
              </select>
            </div>
            <div class="form-field">
              <label for="edit-departamento">Departamento</label>
              <select name="departamento" id="edit-departamento" required>
                <% if (user.rol===1) { %>
                  <% departamentos.forEach(function(dep) { %>
                    <option value="<%= dep.id_departamento %>">
                      <%= dep.nombre %>
                    </option>
                    <% }); %>
                      <% } else { %>
                        <% departamentos.forEach(function(dep) { %>
                          <% if (dep.id_departamento===user.id_departamento || dep.id_departamento===1) { %>
                            <option value="<%= dep.id_departamento %>">
                              <%= dep.nombre %>
                            </option>
                            <% } %>
                              <% }); %>
                                <% } %>
              </select>
            </div>
            <div class="form-field">
              <label for="edit-rol">Rol</label>
              <select name="rol" id="edit-rol" required>
                <% roles.forEach(function(role) { %>
                  <% if(user.rol===1){ %>
                    <option value="<%= role.id_rol %>">
                      <%= role.nombre %>
                    </option>
                    <% }else if(user.rol>=2 && role.id_rol>1){ %>
                      <option value="<%= role.id_rol %>">
                        <%= role.nombre %>
                      </option>
                      <% } }); %>
              </select>
            </div>
            <div class="form-field full">
              <label for="edit-correo">Correo Electrónico</label>
              <input type="email" id="edit-correo" name="correo" placeholder="email@uv.mx" autocomplete="off"
                required />
            </div>
            <div class="form-field full" style="margin-top: 6px;">
              <button class="title-btn" style="width: 100%; justify-content: center; padding: 12px;"
                type="submit">Guardar Cambios</button>
            </div>
          </div>
        </form>
      </div>
    </div>
    <script>
      window.currentUserId = '<%= user.id_usuario %>';
      window.currentUserRol = parseInt('<%= user.id_rol %>');
      window.currentUserDept = parseInt('<%= user.id_departamento %>');
    </script>
    <script src="/js/services/usuarios.service.js"></script>
    <script src="/js/components/usuarios.components.js"></script>
    <script src="/js/components/sidebar.js"></script>
    <script src="/js/components/modals.js"></script>
    <script src="/js/auth.js"></script>
</body>

</html>