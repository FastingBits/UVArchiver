<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>Perfil de Usuario - UV Archiver</title>
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="/img/logo-uv.svg" type="image/x-icon">
</head>

<body>

  <%- include('../components/sidebar.ejs') %>

    <% const initial1=(profileData.nombre && profileData.nombre.length> 0) ? profileData.nombre.charAt(0) : 'U';
      const initial2 = (profileData.apellido_paterno && profileData.apellido_paterno.length > 0) ?
      profileData.apellido_paterno.charAt(0) : '';
      const avatarInitials = (initial1 + initial2).toUpperCase();
      const fullName = `${profileData.nombre} ${profileData.apellido_paterno} ${profileData.apellido_materno ||
      ''}`.trim();

      // Role display helpers
      let roleLabel = 'Auditor';
      let roleClass = 'badge-role-auditor';
      let roleDescription = 'Acceso de solo lectura a expedientes del departamento asignado.';
      let roleIcon = 'fa-eye';

      if (profileData.id_rol === 1 || profileData.nombre_rol === 'system_admin') {
      roleLabel = 'Administrador de Sistema';
      roleClass = 'badge-role-system_admin';
      roleDescription = "Control total de la plataforma, gestión global de departamentos, usuarios y supervisión de expedientes.";
      roleIcon = 'fa-shield-halved';
      } else if (profileData.id_rol === 2 || profileData.nombre_rol === 'admin') {
      roleLabel = 'Administrador de Departamento';
      roleClass = 'badge-role-admin';
      roleDescription = 'Gestión local y operativa de usuarios y expedientes adscritos a su departamento.';
      roleIcon = 'fa-user-tie';
      } else if (profileData.id_rol === 3 || profileData.nombre_rol === 'user') {
      roleLabel = 'Usuario Operativo';
      roleClass = 'badge-role-user';
      roleDescription = 'Carga, consulta y gestión de documentos dentro de su departamento asignado.';
      roleIcon = 'fa-user-gear';
      }
      %>

      <div class="container-user" id="container-user">
        <div
          style="display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 20px;">
          <div style="display: flex; flex-direction: column;">
            <h1>Mi Perfil</h1>
            <p>Gestión de información personal y credenciales de acceso</p>
          </div>
          <button onclick="window.location.href='/api/auth/logout'" class="btn-logout-premium"
            title="Cerrar sesión actual">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-logout">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" />
              <path d="M9 12h12l-3 -3" />
              <path d="M18 15l3 -3" />
            </svg>
          </button>
        </div>

        <div class="profile-container">
          <!-- Hero Banner Card -->
          <div class="profile-hero-card">
            <div class="profile-cover">
              <div class="profile-cover-pattern"></div>
              <img src="/img/logo-uv.svg" alt="Universidad Veracruzana" class="profile-cover-logo">
            </div>
            <div class="profile-hero-content">
              <div class="profile-user-main">
                <div class="profile-avatar-wrapper">
                  <div class="profile-avatar">
                    <%= avatarInitials %>
                  </div>
                  <span class="profile-status-indicator" title="Usuario activo"></span>
                </div>
                <div class="profile-titles">
                  <div class="profile-name-row">
                    <h2 class="profile-name">
                      <%= fullName %>
                    </h2>
                  </div>
                  <div class="profile-badges-row">
                    <span class="badge-pill <%= roleClass %>">
                      <i class="fa-solid <%= roleIcon %>"></i>
                      <%= roleLabel %>
                    </span>
                    <% if (profileData.pertenece_a_institucion===1) { %>
                      <span class="badge-pill badge-institutional">
                        <i class="fa-solid fa-circle-check"></i>
                        Institucional UV
                      </span>
                      <% } else { %>
                        <span class="badge-pill badge-external">
                          <i class="fa-solid fa-user-tag"></i>
                          Usuario Externo
                        </span>
                        <% } %>
                          <span class="profile-email-sub">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                              stroke-linejoin="round">
                              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                              <path
                                d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                              <path d="M3 7l9 6l9 -6" />
                            </svg>
                            <%= profileData.correo %>
                          </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Main Profile Grid -->
          <div class="profile-grid">

            <!-- Left Column: Personal Info -->
            <div class="profile-card">
              <div class="profile-card-header">
                <div class="profile-card-title">
                  <div class="profile-card-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                      <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                    </svg>
                  </div>
                  <h3>Información Personal</h3>
                </div>
              </div>

              <div class="profile-fields-grid">
                <div class="profile-field-tile">
                  <span class="profile-field-label">Nombre(s)</span>
                  <span class="profile-field-value">
                    <%= profileData.nombre %>
                  </span>
                </div>

                <div class="profile-field-tile">
                  <span class="profile-field-label">Apellido Paterno</span>
                  <span class="profile-field-value">
                    <%= profileData.apellido_paterno %>
                  </span>
                </div>

                <div class="profile-field-tile">
                  <span class="profile-field-label">Apellido Materno</span>
                  <span class="profile-field-value">
                    <%= profileData.apellido_materno || 'No especificado' %>
                  </span>
                </div>

                <div class="profile-field-tile">
                  <span class="profile-field-label">Fecha de Registro</span>
                  <span class="profile-field-value">
                    <%= profileData.fecha_registro %>
                  </span>
                </div>

                <div class="profile-field-tile full-width">
                  <span class="profile-field-label">Correo Electrónico</span>
                  <span class="profile-field-value">
                    <%= profileData.correo %>
                  </span>
                </div>

                <div class="profile-field-tile full-width">
                  <span class="profile-field-label">Afiliación Institucional</span>
                  <span class="profile-field-value">
                    <%= profileData.pertenece_a_institucion===1 ? 'Miembro activo de la Universidad Veracruzana'
                      : 'Usuario externo independiente' %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Right Column: Department & Security -->
            <div style="display: flex; flex-direction: column; gap: 24px;">

              <!-- Department & Role Adscription Card -->
              <div class="profile-card">
                <div class="profile-card-header">
                  <div class="profile-card-title">
                    <div class="profile-card-icon accent-green">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M3 21l18 0" />
                        <path d="M5 21v-14l8 -4v18" />
                        <path d="M19 21v-10l-6 -4" />
                        <path d="M9 9l0 .01" />
                        <path d="M9 12l0 .01" />
                        <path d="M9 15l0 .01" />
                        <path d="M9 18l0 .01" />
                      </svg>
                    </div>
                    <h3>Adscripción Departamental</h3>
                  </div>
                </div>

                <div class="profile-highlight-box">
                  <div class="profile-highlight-icon">
                    <i class="fa-solid fa-building"></i>
                  </div>
                  <div class="profile-highlight-info">
                    <span class="profile-highlight-subtitle">Departamento Asignado</span>
                    <span class="profile-highlight-title">
                      <%= profileData.nombre_departamento || 'Sin Departamento' %>
                    </span>
                  </div>
                </div>

                <div class="profile-field-tile full-width"
                  style="background: transparent; border-color: rgba(208, 208, 208, 0.7);">
                  <span class="profile-field-label">Alcance y Permisos del Rol</span>
                  <p class="profile-highlight-desc">
                    <%= roleDescription %>
                  </p>
                </div>
              </div>

              <!-- Account Security & Status Card -->
              <div class="profile-card">
                <div class="profile-card-header">
                  <div class="profile-card-title">
                    <div class="profile-card-icon accent-purple">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
                        <path d="M12 11m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                        <path d="M12 12l0 2.5" />
                      </svg>
                    </div>
                    <h3>Seguridad y Estado de Cuenta</h3>
                  </div>
                </div>

                <div class="security-list">
                  <div class="security-item">
                    <div class="security-item-left">
                      <div class="security-icon">
                        <i class="fa-solid fa-user-check"></i>
                      </div>
                      <div class="security-text">
                        <h4>Estado de la Cuenta</h4>
                        <p>Activa y verificada en el sistema</p>
                      </div>
                    </div>
                    <span class="badge-pill badge-institutional" style="padding: 2px 8px; font-size: 0.75rem;">
                      Activo
                    </span>
                  </div>

                  <div class="security-item">
                    <div class="security-item-left">
                      <div class="security-icon"
                        style="background: rgba(3, 118, 255, 0.1); color: var(--primary-color-accent);">
                        <i class="fa-solid fa-lock"></i>
                      </div>
                      <div class="security-text">
                        <h4>Nivel de Acceso</h4>
                        <p>
                          <%= roleLabel %>
                        </p>
                      </div>
                    </div>
                    <span class="badge-pill <%= roleClass %>"
                      style="padding: 2px 8px; font-size: 0.75rem; white-space: nowrap;">
                      Nivel <%= profileData.id_rol %>
                    </span>
                  </div>

                  <div class="security-item" style="margin-top: 15px; padding-top: 15px; border-top: 1px dashed var(--border-color, #e2e8f0);">
                    <div class="security-item-left">
                      <div class="security-icon"
                        style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="fa-solid fa-key"></i>
                      </div>
                      <div class="security-text">
                        <h4>Contraseña</h4>
                        <p>Actualizacion de tu contraseña</p>
                      </div>
                    </div>
                    <span onclick="location.href='/update-password'" class="badge-pill badge-role-system_admin"
                      style="padding: 2px 8px; font-size: 0.75rem; white-space: nowrap; cursor: pointer;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right" viewBox="0 0 24 24"><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path d="M17 7 7 17M8 7h9v9"/></svg>
                      Actualizar
                    </span>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

      <script>
        window.currentUserRol = parseInt('<%= user.rol %>');
        window.currentUserDept = parseInt('<%= user.id_departamento %>');
      </script>
      <script src="/js/components/sidebar.js"></script>
</body>

</html>