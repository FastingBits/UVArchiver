<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="shortcut icon" href="img/logo-uv.svg" type="image/x-icon">
  <title>Iniciar Sesion</title>
  <link rel="stylesheet" href="css/login.css" />
</head>

<body>
  <% if (typeof error !=='undefined' ) { %>
    <div class="alert">
      <%= error %>
    </div>
    <% } %>
      <div class="container">
        <div class="auth-container">
          <div class="image-login">
            <picture>
              <img src="img/VectorBlue.png" alt="Vector azul">
            </picture>
          </div>
          <form class="login-form" id="loginForm">
            <div style="width: 100%; display:flex; align-items:center; justify-content: center; margin-bottom: 20px;">
              <img src="img/logo-uv.svg" alt="logo-uv" style="width:100px;height:100px;object-fit:contain;">
            </div>
            <div class="logo" onclick="location.href='/'" style="scale:1.3; align-self: center; font-weight: bold;">
              <span style="color:var(--primary-color-accent);">U</span>
              <span style="color:var(--secondary-color);">V</span>
              Archiver
            </div>
            <h2>Iniciar Sesión</h2>
            <div class="input-group">
              <input type="email" id="correo" name="correo" required />
              <label for="correo">Correo</label>
            </div>
            <div class="input-group">
              <input type="password" id="password" name="contraseña" required />
              <label for="password">Contraseña</label>
              <button type="button" class="toggle-password" id="toggleAll" onclick="toggleAllPasswords()">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="icon icon-tabler icons-tabler-outline icon-tabler-eye" viewBox="0 0 24 24"><path fill="none" stroke="none" d="M0 0h24v24H0z"/><path d="M10 12a2 2 0 1 0 4 0 2 2 0 0 0-4 0"/><path d="M21 12q-3.6 6-9 6t-9-6q3.6-6 9-6t9 6"/></svg>
              </button>
            </div>
            <div class="input-group">
              <a href="/forgot-password" style="font-size: 0.85rem; color: var(--primary-color-accent); text-decoration: none; font-weight: 500;">¿Olvidaste tu contraseña?</a>
            </div>
            <div id="message" class="error-message" style="display: none;"></div>
            <button class="btn" type="submit">Entrar</button>
          </form>
        </div>
      </div>

      <script src="/js/utils/toast.js"></script>
      <script src="js/auth.js"></script>
</body>

</html>