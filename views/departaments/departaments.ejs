<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="img/logo-uv.svg" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="css/index.css">
  <title>Departamentos - UV Archiver</title>
</head>

<body>
  <%- include('../components/sidebar.ejs') %>
    <div class="container-user" id="container-user">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 5px;">
        <div style="display: flex; flex-direction: column;">
          <h1>Departamentos</h1>
          <p>Administracion de <strong>Departamentos</strong></p>
        </div>
        <% if (user && user.rol===1) { %>
          <button class="title-btn open-modal-button" data-target="modal-container-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-file-plus">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M14 3v4a1 1 0 0 0 1 1h4" />
              <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2" />
              <path d="M12 11l0 6" />
              <path d="M9 14l6 0" />
            </svg>
            <p>Registrar Departamento</p>
          </button>
          <% } %>
      </div>
      <div class="search-container">
        <div class="input-search-group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-search">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
            <path d="M21 21l-6 -6" />
          </svg>
          <input type="search" id="search-input" placeholder="Buscar por nombre de departamento">
        </div>
      </div>
      <div class="table-container">
        <table class="doc-table">
          <caption>Archivos del departamento</caption>
          <thead>
            <tr>
              <th>NOMBRE DEL ARCHIVO</th>
              <th>DESCRIPCION</th>
              <th>ACCIONES</th>
            </tr>
          </thead>
          <tbody>
            <% departamentos.forEach(function(departamento) { if(departamento.id_departamento===1) { return; } %>
              <tr>
                <td class="file-cell">
                  <div class=" file-icon" data-type="<%= departamento.id_departamento %>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="icon icon-tabler icons-tabler-outline icon-tabler-building-skyscraper">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M3 21l18 0" />
                      <path d="M5 21v-14l8 -4v18" />
                      <path d="M19 21v-10l-6 -4" />
                      <path d="M9 9l0 .01" />
                      <path d="M9 12l0 .01" />
                      <path d="M9 15l0 .01" />
                      <path d="M9 18l0 .01" />
                    </svg>
                  </div>
                  <div class="file-info">
                    <div class="file-name">
                      <%= departamento.nombre %>
                    </div>
                  </div>
                </td>
                <td class="category-cell">
                  <span class="badge badge-<%= departamento.descripcion.toLowerCase().replace(/\s+/g, '-') %>">
                    <%= departamento.descripcion %>
                  </span>
                </td>
                <td class="actions-cell">
                  <a href="/documentos/departamento/<%= departamento.id_departamento %>" class="action-btn view-btn"
                    title="Ver Expedientes"
                    style="display: inline-flex; align-items: center; justify-content: center; text-decoration: none; width: 32px; height: 32px; border-radius: 6px; background-color: var(--primary-color-accent); color: var(--text-light); margin-right: 4px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="icon icon-tabler icons-tabler-outline icon-tabler-eye">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" />
                      <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" />
                    </svg>
                  </a>
                  <button title="Editar Departamento" class="action-btn edit-btn open-modal-button"
                    data-target="modal-container-2" style="margin-right: 4px;"
                    onclick="openEditDeptModal('<%= departamento.id_departamento %>', '<%= departamento.nombre %>', '<%= departamento.descripcion %>')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="icon icon-tabler icons-tabler-outline icon-tabler-pencil">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                      <path d="M13.5 6.5l4 4" />
                    </svg>
                  </button>
                  <button title="Eliminar Departamento" class="action-btn delete-btn"
                    onclick="deleteDepartamento('<%= departamento.id_departamento %>')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                      fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-trash">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path
                        d="M20 6a1 1 0 0 1 .117 1.993l-.117 .007h-.081l-.919 11a3 3 0 0 1 -2.824 2.995l-.176 .005h-8c-1.598 0 -2.904 -1.249 -2.992 -2.75l-.005 -.167l-.923 -11.083h-.08a1 1 0 0 1 -.117 -1.993l.117 -.007zm-10 4a1 1 0 0 0 -1 1v6a1 1 0 0 0 2 0v-6a1 1 0 0 0 -1 -1m4 0a1 1 0 0 0 -1 1v6a1 1 0 0 0 2 0v-6a1 1 0 0 0 -1 -1" />
                      <path
                        d="M14 2a2 2 0 0 1 2 2a1 1 0 0 1 -1.993 .117l-.007 -.117h-4l-.007 .117a1 1 0 0 1 -1.993 -.117a2 2 0 0 1 1.85 -1.995l.15 -.005z" />
                    </svg>
                  </button>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <!-- Modal para Registrar Departamento -->
    <div id="modal-container-1" class="modal modal-content-1">
      <div id="modal-content">
        <div class="modal-head">
          <div class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-building-fortress">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M7 21h10" />
              <path d="M9 21v-14l3 -2l3 2v14" />
              <path d="M12 14M9 14h6" />
            </svg>
            &nbsp;
            <h3>Registrar Nuevo Departamento</h3>
          </div>
          <button class="outline-btn close-modal-button" onclick="closeModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-x">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M18 6l-12 12" />
              <path d="M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form class="form-documento" id="register-dept-form" method="post">
          <div class="form-grid" style="border:none; background-color: transparent;">
            <div class="form-field full">
              <label for="dept-nombre">Nombre del Departamento</label>
              <input type="text" id="dept-nombre" name="nombre" placeholder="Ej. Tecnologías de la Información"
                required>
            </div>
            <div class="form-field full">
              <label for="dept-descripcion">Descripción</label>
              <textarea id="dept-descripcion" name="descripcion"
                placeholder="Describa las responsabilidades del departamento" required></textarea>
            </div>
            <div class="form-field full">
              <button class="title-btn" type="submit">Registrar Departamento</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal para Editar Departamento -->
    <div id="modal-container-2" class="modal modal-content-2">
      <div id="modal-content">
        <div class="modal-head">
          <div class="modal-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-pencil">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
              <path d="M13.5 6.5l4 4" />
            </svg>
            &nbsp;
            <h3>Editar Departamento</h3>
          </div>
          <button class="outline-btn close-modal-button" onclick="closeModal()">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="icon icon-tabler icons-tabler-outline icon-tabler-x">
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M18 6l-12 12" />
              <path d="M6 6l12 12" />
            </svg>
          </button>
        </div>
        <form class="form-documento" id="edit-dept-form" method="post">
          <input type="hidden" id="edit-dept-id" name="id">
          <div class="form-grid" style="border:none; background-color: transparent;">
            <div class="form-field full">
              <label for="edit-dept-nombre">Nombre del Departamento</label>
              <input type="text" id="edit-dept-nombre" name="nombre" placeholder="Nombre" required>
            </div>
            <div class="form-field full">
              <label for="edit-dept-descripcion">Descripción</label>
              <textarea id="edit-dept-descripcion" name="descripcion" placeholder="Descripción" required></textarea>
            </div>
            <div class="form-field full">
              <button class="title-btn" type="submit">Guardar Cambios</button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <script src="/js/services/departamentos.service.js"></script>
    <script src="/js/components/departamentos.components.js"></script>
    <script src="/js/components/sidebar.js"></script>
    <script src="/js/components/modals.js"></script>
</body>

</html>