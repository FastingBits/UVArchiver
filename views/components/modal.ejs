<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="shortcut icon" href="img/logo-uv.svg" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="css/index.css">
  <title>Certificados</title>
</head>

<body>
  <%- include('components/sidebar.ejs') %>
    <div class="container-user" id="container-user">
      <div style="display: flex; justify-content: space-between; align-items: center; gap: 10px;">
        <div style="display: flex; flex-direction: column;">
          <h1>Usuarios</h1>
          <p>Administracion de <strong>usuarios</strong> del sistema</p>
        </div>
        <button title="Agregar Documento" class="title-btn add-doc" onclick="location.href='/'">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-plus">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M12 5l0 14" />
            <path d="M5 12l14 0" />
          </svg>
          <p>Agregar Usuario</p>
        </button>
      </div>
      <div class="search-container">
        <div class="input-search-group">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            class="icon icon-tabler icons-tabler-outline icon-tabler-search">
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
            <path d="M21 21l-6 -6" />
          </svg>
          <input type="search" name="" id="" placeholder="Buscar por nombre de usuario, correo o rol">
          <div class="date-search">
            <label for="filter-date" class="date-picker">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"
                class="icon icon-tabler icons-tabler-filled icon-tabler-calendar-event">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path
                  d="M16 2a1 1 0 0 1 .993 .883l.007 .117v1h1a3 3 0 0 1 2.995 2.824l.005 .176v12a3 3 0 0 1 -2.824 2.995l-.176 .005h-12a3 3 0 0 1 -2.995 -2.824l-.005 -.176v-12a3 3 0 0 1 2.824 -2.995l.176 -.005h1v-1a1 1 0 0 1 1.993 -.117l.007 .117v1h6v-1a1 1 0 0 1 1 -1m3 8h-14v8.625c0 .705 .386 1.286 .883 1.366l.117 .009h12c.513 0 .936 -.53 .993 -1.215l.007 -.16zm-9 4a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-2a1 1 0 0 1 -1 -1v-2a1 1 0 0 1 1 -1z" />
              </svg>
            </label>
            <input type="date" id="filter-date">
          </div>
        </div>
      </div>
      <div
        style="width: 100%; max-width: 100%; background-color: var(--background-light); padding: 0; border-radius: 10px; border: 1px solid var(--border-color); overflow-x: auto; overflow-y: hidden;">
        <table class="doc-table">
          <thead>
            <tr>
              <th>NOMBRE DE USUARIO</th>
              <th>CORREO</th>
              <th>ROL</th>
              <th>FECHA REGISTRO</th>
              <th>ACCIONES</th>
            </tr>
          </thead>
          <tbody>
            <% usuarios.forEach(function(usr) { %>
              <tr>
                <td class="file-cell">
                  <div class="file-icon" data-type="<%= usr.nombre %>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                      stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="icon icon-tabler icons-tabler-outline icon-tabler-user">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                      <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                    </svg>
                  </div>
                  <div class="file-info">
                    <div class="file-name">
                      <%= usr.nombre %>
                        <%= usr.apellido_paterno %>
                          <%= usr.apellido_materno %>
                    </div>
                  </div>
                </td>
                <td class="category-cell">
                  <p>
                    <%= usr.correo %>
                  </p>
                </td>
                <td class="date-cell">
                  <%= usr.nombre_rol %>
                </td>
                <td class="owner-cell">
                  <%= new Date(usr.fecha_registro).toLocaleDateString('es-ES', { year: 'numeric' , month: 'long' ,
                    day: '2-digit' }) %>
                </td>
                <td class="actions-cell">
                  <button title="Eliminar Documento" class="action-btn delete-btn"
                    onclick="alert('Eliminando usuario con id: <%= usr.id_usuario %>')">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                      fill="currentColor" class="icon icon-tabler icons-tabler-filled icon-tabler-trash">
                      <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                      <path
                        d="M20 6a1 1 0 0 1 .117 1.993l-.117 .007h-.081l-.919 11a3 3 0 0 1 -2.824 2.995l-.176 .005h-8c-1.598 0 -2.904 -1.249 -2.992 -2.75l-.005 -.167l-.923 -11.083h-.08a1 1 0 0 1 -.117 -1.993l.117 -.007zm-10 4a1 1 0 0 0 -1 1v6a1 1 0 0 0 2 0v-6a1 1 0 0 0 -1 -1m4 0a1 1 0 0 0 -1 1v6a1 1 0 0 0 2 0v-6a1 1 0 0 0 -1 -1" />
                      <path
                        d="M14 2a2 2 0 0 1 2 2a1 1 0 0 1 -1.993 .117l-.007 -.117h-4l-.007 .117a1 1 0 0 1 -1.993 -.117a2 2 0 0 1 1.85 -1.995l.15 -.005z" />
                    </svg>
                  </button>
                </td>
              </tr>
              <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <%- include('pdfcomponents/modal.ejs') %>
      <script src="js/sidebar.js"></script>
</body>

</html>